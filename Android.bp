soong_namespace {
    imports: [
        "hardware/qcom-caf/common",
        "hardware/qcom-caf/bootctrl",
    ],
}

install_symlink {
    name: "firmware_wlan_mac.bin_symlink",
    vendor: true,
    installed_location: "firmware/wlan_mac.bin",
    symlink_target: "/mnt/vendor/persist/wlan_mac.bin",
}

install_symlink {
    name: "firmware_WCNSS_qcom_cfg.ini_symlink",
    vendor: true,
    installed_location: "firmware/wlan/prima/WCNSS_qcom_cfg.ini",
    symlink_target: "/vendor/etc/wifi/WCNSS_qcom_cfg.ini",
}

install_symlink {
    name: "firmware_wlanmdsp.mbn_symlink",
    vendor: true,
    installed_location: "firmware/wlanmdsp.mbn",
    symlink_target: "/vendor/firmware_mnt/image/wlanmdsp.mbn",
}
