# Permissões de leitura para bateria
r_dir_file(charger_vendor, sysfs_power_supply)
r_dir_file(charger_vendor, sysfs_batteryinfo)

# Permite ler os arquivos de recursos (imagens e fontes) na partição vendor
allow charger_vendor vendor_configs_file:file r_file_perms;
allow charger_vendor vendor_configs_file:dir r_dir_perms;

# Permissão de escrita (rw) no GPU/DRM para desenhar na tela
allow charger_vendor gpu_device:chr_file rw_file_perms;
allow charger_vendor gpu_device:dir r_dir_perms;

# Permissão para o dispositivo gráfico/framebuffer (Onde o sinal de carregando aparece)
allow charger_vendor graphics_device:chr_file rw_file_perms;
allow charger_vendor graphics_device:dir r_dir_perms;

# Necessário para gerenciar o display no Android 16
allow charger_vendor self:capability sys_admin;

# Mantém o modo permissivo para debug (essencial em userdebug para ignorar outros pequenos bloqueios)
userdebug_or_eng(`
  permissive charger;
  permissive charger_vendor;
')
